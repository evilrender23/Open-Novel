{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Novel",
  "version": "0.1.0",
  "identifier": "org.opennovel.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Open Novel",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#f8f9fb"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Escribe novelas con Codex, IA y Claude Code",
    "longDescription": "Open Novel es un entorno de escritura de novelas de código abierto inspirado en NovelCrafter: planificación, manuscrito, Codex de mundo, chat con IA, prompts personalizables y un modo agente que usa Claude Code CLI sobre los archivos de tu novela."
  }
}
